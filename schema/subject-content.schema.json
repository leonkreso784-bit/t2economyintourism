{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.sokratstudy.com/schema/subject-content.schema.json",
  "title": "Sokrat Study — Subject Content Document",
  "description": "Kanonski oblik JEDNOG payloada sadrzaja: jedna window-varijabla = kategorije jedne lekcije (M1/M2), ili spojeni 'final'. Kljuc = camelCase ID kategorije; vrijednost = Category. Vjeran validate-content.js + docs/content/CONTENT_SCHEMA.md, ukljucujuci stvarna polja nadena u zivim podacima: quiz.image/imageAlt (Geography 'koji grad je na slici') i learn.title, learn.image=null. Ovo je STRUKTURNI ugovor (oblik + tipovi + nepoznata polja). SEMANTICKE provjere (quiz.correct u rasponu 0..options-1, KaTeX currency-safe balans, _______ praznina) i dalje radi scripts/validate-content.js — dvije razine se nadopunjuju.",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": { "$ref": "#/definitions/category" },
  "definitions": {
    "category": {
      "type": "object",
      "required": ["name", "icon", "color"],
      "additionalProperties": false,
      "properties": {
        "id":    { "type": "string", "minLength": 1 },
        "name":  { "type": "string", "minLength": 1 },
        "icon":  { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "flashcards": { "type": "array", "items": { "$ref": "#/definitions/flashcard" } },
        "quiz":       { "type": "array", "items": { "$ref": "#/definitions/quiz" } },
        "fillBlanks": { "type": "array", "items": { "$ref": "#/definitions/fillBlank" } },
        "learn":      { "$ref": "#/definitions/learn" }
      },
      "anyOf": [
        { "required": ["flashcards"] },
        { "required": ["quiz"] },
        { "required": ["fillBlanks"] },
        { "required": ["learn"] }
      ]
    },
    "flashcard": {
      "type": "object",
      "required": ["question", "answer"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string", "minLength": 1 },
        "question":    { "type": "string", "minLength": 1 },
        "answer":      { "type": "string", "minLength": 1 },
        "explanation": { "type": "string" }
      }
    },
    "quiz": {
      "type": "object",
      "required": ["question", "options", "correct"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "options":  { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "correct":  { "type": "integer", "minimum": 0 },
        "image":    { "type": "string", "minLength": 1 },
        "imageAlt": { "type": "string" }
      }
    },
    "fillBlank": {
      "type": "object",
      "required": ["sentence", "answer"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "minLength": 1 },
        "sentence": { "type": "string", "minLength": 1, "pattern": "_______" },
        "answer":   { "type": "string", "minLength": 1 },
        "hint":     { "type": "string" }
      }
    },
    "learn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "title":   { "type": "string" },
        "content": { "type": "string", "minLength": 1 },
        "image":   { "type": ["string", "null"] },
        "blocks":  { "type": "array", "items": { "$ref": "#/definitions/block" } }
      },
      "anyOf": [
        { "required": ["content"] },
        { "required": ["blocks"] }
      ]
    },

    "inline": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/definitions/run" } }
      ]
    },
    "run": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text":  { "type": "string" },
        "b":     { "type": "boolean" },
        "i":     { "type": "boolean" },
        "color": { "type": "string", "enum": ["indigo", "green", "amber", "red", "default"] },
        "href":  { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/definitions/blockHeading" },
        { "$ref": "#/definitions/blockParagraph" },
        { "$ref": "#/definitions/blockList" },
        { "$ref": "#/definitions/blockCallout" },
        { "$ref": "#/definitions/blockImage" },
        { "$ref": "#/definitions/blockVideo" },
        { "$ref": "#/definitions/blockTable" },
        { "$ref": "#/definitions/blockFormula" },
        { "$ref": "#/definitions/blockLegacyHtml" }
      ]
    },
    "blockHeading": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "id":    { "type": "string", "minLength": 1 },
        "type":  { "const": "heading" },
        "level": { "type": "integer", "minimum": 2, "maximum": 4 },
        "text":  { "$ref": "#/definitions/inline" }
      }
    },
    "blockParagraph": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "id":   { "type": "string", "minLength": 1 },
        "type": { "const": "paragraph" },
        "text": { "$ref": "#/definitions/inline" }
      }
    },
    "blockList": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "type":    { "const": "list" },
        "ordered": { "type": "boolean" },
        "items":   { "type": "array", "items": { "$ref": "#/definitions/inline" } }
      }
    },
    "blockCallout": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "type":    { "const": "callout" },
        "variant": { "type": "string", "enum": ["info", "warning", "tip"] },
        "title":   { "type": "string" },
        "text":    { "$ref": "#/definitions/inline" }
      }
    },
    "blockImage": {
      "type": "object",
      "required": ["type", "src"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "type":    { "const": "image" },
        "src":     { "type": "string", "minLength": 1 },
        "alt":     { "type": "string" },
        "caption": { "$ref": "#/definitions/inline" }
      }
    },
    "blockVideo": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "type":    { "const": "video" },
        "videoId": { "type": "string", "minLength": 1 },
        "url":     { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["videoId"] },
        { "required": ["url"] }
      ]
    },
    "blockTable": {
      "type": "object",
      "required": ["type", "rows"],
      "additionalProperties": false,
      "properties": {
        "id":     { "type": "string", "minLength": 1 },
        "type":   { "const": "table" },
        "header": { "type": "array", "items": { "$ref": "#/definitions/inline" } },
        "rows":   { "type": "array", "items": { "type": "array", "items": { "$ref": "#/definitions/inline" } } }
      }
    },
    "blockFormula": {
      "type": "object",
      "required": ["type", "tex"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "type":    { "const": "formula" },
        "tex":     { "type": "string", "minLength": 1 },
        "display": { "type": "boolean" }
      }
    },
    "blockLegacyHtml": {
      "type": "object",
      "required": ["type", "html"],
      "additionalProperties": false,
      "properties": {
        "id":   { "type": "string", "minLength": 1 },
        "type": { "const": "legacy-html" },
        "html": { "type": "string" }
      }
    }
  }
}
