# Predložak za lokalne tajne. KOPIRAJ u `.env` i popuni stvarnim vrijednostima.
# `.env` je u .gitignore — NIKAD se ne commita, NIKAD se ne lijepi u chat.

# Anthropic API ključ za generator predmeta (scripts/generate-subject.js).
# Dobiva se na console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model za drafting (default: claude-sonnet-4-6 ako je prazno).
GENERATOR_MODEL=claude-sonnet-4-6

# --- Blok B: migracija sadržaja u Supabase (scripts/migrate-content.js) ---
# SAMO za migracijsku skriptu (server-side, jednokratno). NIKAD u frontend!
# Frontend čita sadržaj anon/publishable keyem (vidi js/auth.js) — service key je ZA UPLOAD.
# SUPABASE_URL = Project URL; SUPABASE_SERVICE_KEY = Settings → API → service_role (secret).
SUPABASE_URL=https://naxjubnedhrbhsuasayu.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...
