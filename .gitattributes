# Generirani JSON export sadržaja (F2 2A) — UVIJEK LF, neovisno o platformi / core.autocrlf.
# Exporter (scripts/export-content-json.js) piše LF; ovim je i radna kopija LF, pa je
# `npm run export:json --check` deterministički stabilan na Windows/Linux (CI).
data/json/**/*.json text eol=lf

# Generirani CSS bundle (F3 3B) — UVIJEK LF (build-css.js normalizira \r\n→\n) da je
# `npm run build:css -- --check` drift-gate deterministički stabilan na Windows/Linux (CI).
styles.bundle.css text eol=lf

# Git hookovi (deploy-guard, risk-sanacija #1) — UVIJEK LF: CRLF u shell-shebangu
# (`#!/bin/sh\r`) puca izvršavanje na Unix/CI klonovima. Radna kopija ostaje LF.
.githooks/** text eol=lf

# Vendorane biblioteke (F6 2/0d) — BAJT-ISTE izdavačevima: loader ih provjerava SRI-hashem, a
# autocrlf bi ih na Windows-klonu pretvorio u CRLF → drugi hash → preglednik ih BLOKIRA i sadržaj
# s HTML-om ide kao tekst. `-text` = git ih nikad ne dira.
vendor/** -text
