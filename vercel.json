{
  "version": 2,
  "name": "sokrat-study",
  "rewrites": [
    {
      "source": "/mcp",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "www.sokratstudy.com"
          }
        }
      ],
      "destination": "https://naxjubnedhrbhsuasayu.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:put*",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "www.sokratstudy.com"
          }
        }
      ],
      "destination": "https://naxjubnedhrbhsuasayu.supabase.co/functions/v1/mcp/:put*"
    },
    {
      "source": "/mcp",
      "has": [
        {
          "type": "host",
          "value": "^studymaster-git-feat-[a-z0-9-]+-leon-kresos-projects\\.vercel\\.app$"
        }
      ],
      "destination": "https://czljmvigkgiajzjxtndq.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:put*",
      "has": [
        {
          "type": "host",
          "value": "^studymaster-git-feat-[a-z0-9-]+-leon-kresos-projects\\.vercel\\.app$"
        }
      ],
      "destination": "https://czljmvigkgiajzjxtndq.supabase.co/functions/v1/mcp/:put*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://js-de.sentry-cdn.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; connect-src 'self' https://api.pwnedpasswords.com https://naxjubnedhrbhsuasayu.supabase.co wss://naxjubnedhrbhsuasayu.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.ingest.de.sentry.io https://js-de.sentry-cdn.com; frame-src https://www.youtube-nocookie.com; media-src 'self' https://naxjubnedhrbhsuasayu.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
