#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# Deploy-guard (risk-sanacija #1): blokira push na `main` ako preflight gate-ovi
# padnu. `main` = PRODUKCIJA (Vercel), a direktan push (bypass) preskače CI —
# ovaj hook je posljednja mreža protiv nevidljivog/slomljenog deploya (BUG-004).
#
# AKTIVIRAJ JEDNOM po klonu:   git config core.hooksPath .githooks
#
# Pušta SVE ostale grane bez provjere (brzi feature/preview pushevi netaknuti);
# preflight se vrti ISKLJUČIVO kad je odredište refs/heads/main.
# ─────────────────────────────────────────────────────────────────────────────

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "[pre-push] Odredište = main (PRODUKCIJA) → pokrećem 'npm run preflight'…"
      # GIT_* se BRIŠE prije preflighta (2026-09-26): git kuki izvozi GIT_DIR, a preflight vrti testove
      # koji pozivaju git u VLASTITIM privremenim mapama. S naslijeđenim GIT_DIR-om `git init` u takvoj
      # mapi ponovno inicijalizira OVAJ repozitorij i postavi `core.bare = true` — glavno stablo prestane
      # biti radno stablo, a push padne. Preflight bez GIT_* nalazi repozitorij iz cwd-a (korijen stabla
      # iz kojeg se pusha) — isto kao kad se vrti ručno. Brana: tests/unit/git-okolina.test.js.
      if ! (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY; npm run preflight); then
        echo ""
        echo "[pre-push] ❌ PREFLIGHT PAO — push na main ODBIJEN."
        echo "[pre-push]    Popravi gate-ove (najčešće: 'npm run bump' nakon izmjene css/js/data),"
        echo "[pre-push]    pa pokušaj ponovno. (Svjestan bypass: 'git push --no-verify' — NE preporuča se.)"
        exit 1
      fi
      echo "[pre-push] ✅ Preflight prošao — dopuštam push na main."
      ;;
  esac
done

exit 0
