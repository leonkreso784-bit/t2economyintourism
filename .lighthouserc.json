{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/static-server.js",
      "startServerReadyPattern": "static server on",
      "url": ["http://localhost:5050/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "//": "Kalibrirano na stvarne CI-brojeve (2026-06-29): a11y 98 / best-practices 100 / seo 100 → tvrdi 0.95 (deterministički). Performance 66 (LCP 6.6s) je render-blocking CSS/fonts — diže se u F3 (bundling+defer+SW); zato perf zasad nizak floor + tvrdi CLS/TBT (mjerljivi, ne bučni). PODIĆI perf prema 0.9 nakon F3.",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.5 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 400 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
