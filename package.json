{
  "name": "sokrat-study",
  "version": "2.0.0",
  "description": "Interactive study application for Tourism Economics, Entrepreneurship and Innovation, and Accounting - Flashcards, Quizzes, Fill-in-the-blank exercises",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve . -l 3000",
    "serve:test": "node scripts/static-server.js",
    "test:responsive": "playwright test",
    "test:authed": "playwright test --project=authenticated",
    "test:unit": "node tests/unit/exercises-core.test.js && node tests/unit/acc-kernel.test.js && node tests/unit/stat-parse.test.js && node tests/unit/stat-lib.test.js && node tests/unit/app-state.test.js && node tests/unit/catalog-placement.test.js",
    "test:rls": "node scripts/rls-check.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "stats": "node scripts/compute-stats.js",
    "bump": "node scripts/bump-version.js",
    "bump:check": "node scripts/bump-version.js --check",
    "build:css": "node scripts/build-css.js",
    "verify": "node scripts/verify-catalog.js",
    "verify:catalog": "node scripts/verify-catalog.js",
    "validate:content": "node scripts/validate-content.js",
    "validate:schema": "node scripts/validate-json-schema.js",
    "export:json": "node scripts/export-content-json.js",
    "scaffold": "node scripts/scaffold-subject.js"
  },
  "keywords": [
    "tourism",
    "economics",
    "entrepreneurship",
    "accounting",
    "education",
    "flashcards",
    "quiz",
    "study"
  ],
  "author": "Leon Kreso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonkreso784-bit/t2economyintourism.git"
  },
  "homepage": "https://t2economyintourism.vercel.app",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "pdf-parse": "^2.4.5",
    "typescript": "^6.0.3"
  }
}
